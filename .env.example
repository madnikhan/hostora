# Public
NEXT_PUBLIC_SITE_URL=https://hostorasoft.co.uk

# Google Calendar (service account)
# 1. Create a GCP project → enable Calendar API
# 2. Create a service account + JSON key
# 3. Share that calendar with the service account (Make changes to events)
# Calendar ID = Settings → Integrate calendar (email or …@group.calendar.google.com)
# Put real values in .env.local only — never commit keys
GOOGLE_SERVICE_ACCOUNT_EMAIL=hostorasoft@inventivebytellc.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# IONOS SMTP (send as sales@)
SMTP_HOST=smtp.ionos.co.uk
SMTP_PORT=587
SMTP_USER=sales@hostorasoft.co.uk
SMTP_PASS=
BOOKING_FROM_EMAIL="Hostora <sales@hostorasoft.co.uk>"

# Booking rules
BOOKING_NOTIFY_EMAILS=sales@hostorasoft.co.uk,madnikhan1@gmail.com
BOOKING_TIMEZONE=Europe/London
BOOKING_DURATION_MINUTES=30
BOOKING_HOURS=09:00-17:00
