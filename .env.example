# Public (use www — apex may 308 and inflate crawler timing)
NEXT_PUBLIC_SITE_URL=https://www.hostorasoft.co.uk
# Soro Connect → Embed ID (script: app.trysoro.com/api/embed/<id>)
# Mounted on /blog — Soro has no webhook for this Next.js site
NEXT_PUBLIC_SORO_EMBED_ID=f4209b93-9cbd-4ae4-b286-ded667a515ef

# Google Calendar (service account)
# 1. Create a GCP project → enable Calendar API
# 2. Create a service account + JSON key
# 3. Share that calendar with the service account (Make changes to events)
# Calendar ID = Settings → Integrate calendar (email or …@group.calendar.google.com)
# Put real values in .env.local only — never commit keys
GOOGLE_SERVICE_ACCOUNT_EMAIL=hostorasoft@inventivebytellc.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# IONOS SMTP (send as sales@)
SMTP_HOST=smtp.ionos.co.uk
SMTP_PORT=587
SMTP_USER=sales@hostorasoft.co.uk
SMTP_PASS=
BOOKING_FROM_EMAIL="Hostora <sales@hostorasoft.co.uk>"

# Booking rules
BOOKING_NOTIFY_EMAILS=sales@hostorasoft.co.uk,madnikhan1@gmail.com
BOOKING_TIMEZONE=Europe/London
BOOKING_DURATION_MINUTES=30
BOOKING_HOURS=09:00-17:00

# Demo leads CRM reminders (Vercel Cron → /api/admin/leads/remind at 08:00 UTC)
# Vercel injects Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Hostora blog publish (seo:publish → POST /api/blog/publish)
BLOG_PUBLISH_SECRET=
# BLOG_PUBLISH_URL=https://www.hostorasoft.co.uk/api/blog/publish
# Legacy alias (optional): SORO_WEBHOOK_SECRET=
# Vercel Blob — required on Production for live admin publish + durable posts
BLOB_READ_WRITE_TOKEN=

# /admin/seo console (password gate; cookie signed with ADMIN_SEO_SECRET)
# Falls back to BLOG_PUBLISH_SECRET for password and/or signing if unset
ADMIN_SEO_PASSWORD=
ADMIN_SEO_SECRET=

# Hostora SEO draft pipeline (npm run seo:draft OR admin Generate draft)
# OpenAI-compatible Chat Completions API
# For /admin/seo Generate draft this MUST be set on Vercel Production as well
SEO_LLM_API_KEY=
# SEO_LLM_BASE_URL=https://api.openai.com/v1
# SEO_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=   # accepted as fallback for SEO_LLM_API_KEY

# Optional Google Search Console topic hints (npm run seo:gsc)
# Share the Search Console property with GOOGLE_SERVICE_ACCOUNT_EMAIL (Full user)
# GSC_PROPERTY=sc-domain:hostorasoft.co.uk
# or GSC_PROPERTY=https://hostorasoft.co.uk/
